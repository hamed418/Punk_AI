# ── App ──────────────────────────────────────────────────────────────
APP_NAME=PunkAI
APP_VERSION=0.2.0
DEBUG=true
ENVIRONMENT=development

# ── Security ─────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (PostgreSQL) ─────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=emptyad

# ── Redis ─────────────────────────────────────────────────────────────
# Empty host = Redis off: chat run state and rate limits stay per-process (fine
# for one local instance). Set it to share them across Cloud Run instances; the
# arq retention worker (app/worker.py) needs it to run at all.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── LLM (Gemini on Vertex — Gemini Enterprise Agent Platform) ─────────
# No API key: authenticates with Application Default Credentials. Locally run
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project <GCP_PROJECT>
# In prod the Cloud Run service account (roles/aiplatform.user) is used.
GCP_PROJECT_ID=<GCP_PROJECT>
VERTEX_LOCATION=global
# Fast tier (routers/classifiers/extraction). Brain tier is GEMINI_MODEL_PRO
# (default gemini-3.5-flash). gemini-2.5-* is discontinued 2026-10-20.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.7

# Max messages before summarizer triggers (approx tokens)
SUMMARIZER_THRESHOLD= 50
SUMMARIZER_KEEP_LAST= 10  # Keep most recent N messages after summarize

# ── Maps & Places ─────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Ad Platforms ──────────────────────────────────────────────────────
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# Any string, as long as it matches what is typed into the Meta app's Webhooks
# settings — Meta echoes it back once when it verifies GET /tracking/webhook, and
# that endpoint refuses every handshake while this is empty. Only needed to
# receive instant-form leads; the app's secret above signs the deliveries.
META_WEBHOOK_VERIFY_TOKEN=
# Where the advertiser's own site or CRM POSTs conversions. Printed verbatim into
# the install snippet Punk hands them, so those requests carry raw email, phone
# and address — the app refuses to start if this is http:// anywhere but
# localhost. Leave it as the localhost default for development.
BACKEND_PUBLIC_URL=http://localhost:8000
GOOGLE_CLIENT_ID=176573531597-lkt69if4vktjh9p465f3pufbjr8io1ge.apps.googleusercontent.com
# One place decides the Graph API version — OAuth, publish, insights and the
# campaign-manager reads all derive their URLs from it. It used to be hardcoded
# in six files as well, so bumping the setting moved some calls and not others.
META_API_VERSION=v26.0
# Must point at the backend callback route, not the frontend. The frontend is
# redirected to afterwards (FRONTEND_URL). This example previously pointed at
# the frontend, which does not handle the OAuth code exchange.
META_REDIRECT_URI=http://localhost:8000/ads/callback/meta
# Facebook Login for Business configuration id. Required — the classic
# consumer-login scope-list flow is gone, every connection now goes through
# this configuration and mints a Business Integration System User token.
META_LOGIN_CONFIG_ID=

# Post-publish campaign manager: pipeboard meta-ads-mcp (uses Punk OAuth token)
META_MCP_ENABLED=true
META_MCP_CONNECT_TIMEOUT_S=45

# The final activation pass. Everything Punk creates is PAUSED, and this step is
# what flips it live. Set false to publish end-to-end with nothing spending —
# the only safe setting on any environment whose MAID audiences are demo data,
# because publishing a demo audience for real can get the ad account banned.
# Defaults true, so leaving it out keeps production behaviour.
META_PUBLISH_ACTIVATE=true

# upload
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
MEDIA_UPLOAD_DIR=uploads

# ── Creative generation (Gemini Developer API: image) ─────────────────
# FUTURE WORK: Disconnected for Version 1. AI image creative generation is
# scheduled for a future release (widget stays upload-only).
CREATIVE_GEN_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image


# ── Search (DuckDuckGo used as fallback if unset) ─────────────────────
TAVILY_API_KEY=

# ── Gemini grounding (live web facts) ─────────────────────────────────
# One kill-switch for every surface that grounds against the live web: geo
# event/place discovery and the knowledge_based branch. Uses the same LLM
# auth as above. Set false to degrade each caller to its legacy path (Tavily+geocode,
# no fallback pin, static knowledge blurb). Was GEO_GROUNDING_ENABLED — the old
# name still works.
GROUNDING_ENABLED=true

#stripe credential set  ─────────────────────
# Required — these no longer have defaults in config.py. The previous defaults
# were live test-mode keys committed to the repo; treat them as leaked and
# rotate them in the Stripe dashboard.
STRIPE_PUBLISHABLE_KEY=your_publish_key
STRIPE_SECRET_KEY=your_secret_key
STRIPE_WEBHOOK_SECRET=your_webhook_signing_secret

# Shared secret for the X-API-Key guard. Required — an empty value now rejects
# every request instead of falling back to a hardcoded key.
API_KEY=

# ── Unacast / Gravy Analytics — the only audience data source ─────────
# DIRECT-only account — no EXPORT access. An empty token disables audience
# extraction; a failed query is reported as failed, never replaced with a
# synthetic audience.
#
# EGRESS: the API allowlists source IPs. Requests must leave from the static
# Cloud NAT address (unacast-nat-ip on Cloud Router unacast-router, region
# northamerica-northeast1). A 403 "Unauthorized IP address" means traffic is not
# going through that NAT — an infrastructure fault, not a data problem.
UNACAST_API_TOKEN=
# "staging" (default) or "production". Production spends the real contract quota,
# so it is a deliberate, explicit flip — never the fallback for a missing value.
UNACAST_ENV=staging
# Shared, platform-wide, first-come-first-served monthly cap on API CALLS —
# across every customer and campaign. A call costs one unit whatever it returns,
# so batch size is free (up to the endpoint's 10 features per request).
# NOT the same thing as the identically-numbered 100,000-observations-per-search-
# feature cap the DIRECT endpoint truncates responses at: that one is about data
# completeness (observationLimitHit), not quota.
UNACAST_MONTHLY_CALL_BUDGET=100000
# Confirmed account limit — one shared key, platform-wide, FCFS, no per-session
# reservation.
UNACAST_MAX_CONCURRENT_CALLS=8
# The vendor errors a request out at 190s. Sit just above it so the server's own
# error (with its reason) arrives instead of a client-side timeout that discards
# it. Must stay BELOW UNACAST_LEASE_STALE_AFTER_S.
UNACAST_REQUEST_TIMEOUT_S=195
# A held concurrency lease older than this is presumed abandoned (a crashed
# request that never released its slot) and is reaped. Must exceed
# UNACAST_REQUEST_TIMEOUT_S **plus the persist budget** — the lease is held
# across parse_response and persist_rows too, not just the HTTP call, so a
# 45s margin could be eaten by a large response and the lease reaped as
# abandoned while the call was still running (over-admitting the gate).
UNACAST_LEASE_STALE_AFTER_S=420

# Signal-quality gate (app/graph/maid_signal.py). Applied client-side on stored
# pings, so retuning re-derives an existing extraction with no new vendor call.
# Measured on 287k real pings (docs/maid_signal_quality_baseline.md):
#   off        -> 39,023 devices (counts 14.6% drive-by, 17.8% too-imprecise)
#   permissive -> 33,156 devices (-15%)  <- default
#   strict     -> 27,544 devices (-29%)
MAID_ACCURACY_MODE=permissive
# Empty = the vendor's place-visit preset (SPOOF_LOCATION, OVER_CAPACITY_DEVICE,
# LAT_GRID_LOCATION, LIKELY_DRIVING). Accepts a bitmask or comma-separated names.
MAID_EXCLUDE_FLAGS=

# Circuit breaker. A call is committed to the ledger before the request returns
# (correct — reaching the vendor consumes quota), so without a breaker a vendor
# outage drains the shared monthly budget while returning nothing.
UNACAST_BREAKER_THRESHOLD=5
UNACAST_BREAKER_COOLDOWN_S=300
# Shared slots ONE extraction may hold. Below UNACAST_MAX_CONCURRENT_CALLS on
# purpose: that gate is for fairness across users.
UNACAST_MAX_CONCURRENT_PER_EXTRACTION=4
# Predicted observations one request may carry (~20 s + 0.65 s per 1k obs;
# vendor ceiling 180 s). Lower if requests time out on dense areas.
UNACAST_TARGET_OBS_PER_REQUEST=100000
# Local-dev only: a SOCKS/HTTP proxy that egresses from the allowlisted NAT
# above (e.g. socks5://127.0.0.1:1080 over an IAP tunnel to <TUNNEL_VM>).
# LEAVE EMPTY in every deployed environment — there the Cloud NAT already
# supplies the address. Scoped to UnacastClient; nothing else is proxied.
UNACAST_PROXY_URL=

# ── Visit clustering ──────────────────────────────────────────────────────
# How long a gap between two pings starts a NEW visit. `min_visits` reads
# straight off this, and it swings counts ~2x end to end — measured on 84,473
# gated pings (docs/maid_signal_quality_baseline.md section 9):
#   5 min -> 46,137 visits    20 min -> 30,791 (default)    120 min -> 22,279
# Every visit records the gap it was built with, so a stored extraction stays
# comparable and re-derivable.
MAID_VISIT_GAP_MINUTES=20
# Per-category overrides — a forecourt stop and an afternoon at a mall are not
# the same shape. Empty by default so no values are invented.
# Example: "gas station:10,shopping mall:45"
MAID_VISIT_GAP_BY_CATEGORY=

# ── Scheduled maintenance (app/core/maintenance.py) ───────────────────────
# Retention windows for the two sweeps the arq worker (app/worker.py) runs daily
# at 04:00 UTC. 90 days matches the DIRECT endpoint's span cap, so nothing still
# reachable in one vendor request is deleted. unacast_raw_observations holds real
# advertiser IDs and is cross-campaign — the larger privacy exposure of the two.
UNACAST_RAW_RETENTION_DAYS=90
MAID_EXTRACTION_RETENTION_DAYS=7


# ── Cloudflare R2 (media uploads) ─────────────────────────────────────
# Real values belong in your local .env and the deployed environment, never in
# this tracked file.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://pub-<hash>.r2.dev



# ── Frontend ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── LangSmith tracing ─────────────────────────────────────────────────
# Set TRACING=true and paste your key from https://smith.langchain.com (Settings → API Keys)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=PunkAI
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
